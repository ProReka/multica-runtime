# =============================================================================
# Multica Runtime — configuration
# =============================================================================
# Copy this file and fill in the four REQUIRED values:
#
#     cp .env.example .env
#     $EDITOR .env
#
# Everything else is optional. Full reference: docs/configuration.md
# =============================================================================


# -----------------------------------------------------------------------------
# 1. Multica — REQUIRED
# -----------------------------------------------------------------------------
# Personal access token. Create one at:
#   https://multica.ai/settings?tab=tokens
MULTICA_TOKEN=

# Self-hosted Multica? Set the server URL. Leave empty for Multica Cloud.
# MULTICA_SERVER_URL=https://multica.example.com

# The workspace the runtime should register in. Optional; the daemon registers
# in every workspace the token can reach unless you scope it.
# MULTICA_WORKSPACE=

# Scope runtime registration to one or more workspace IDs/slugs (comma-separated).
# Strongly recommended when the token belongs to several workspaces.
# MULTICA_DAEMON_WORKSPACE_ALLOWLIST=

# Stable runtime identity. Set this to keep the same runtime (and its agent
# bindings + session history) across restarts. If unset, the container hostname
# is used and every restart creates a new runtime.
MULTICA_DAEMON_ID=multica-runtime

# Name shown in the Multica dashboard.
MULTICA_AGENT_RUNTIME_NAME=Multica Runtime

# How many tasks this runtime may run in parallel.
MULTICA_DAEMON_MAX_CONCURRENT_TASKS=3


# -----------------------------------------------------------------------------
# 2. AI router — REQUIRED
# -----------------------------------------------------------------------------
# Any Anthropic-compatible endpoint works. Claude Code and OpenCode are wired to
# the same endpoint from these three values — you do not configure them twice.
#
# Examples:
#   Anthropic directly : https://api.anthropic.com
#   Anthropic router   : http://router.internal:20128
#   OpenAI-only router : works for OpenCode, but Claude Code needs an
#                        Anthropic-compatible surface (see docs/faq.md)
AI_BASE_URL=

# Credential for the endpoint above.
#   api.anthropic.com  → sent as x-api-key
#   any other URL      → sent as Authorization: Bearer
AI_API_KEY=

# Main model name, exactly as your router exposes it.
#   Anthropic : claude-sonnet-4-5
#   Router    : general
AI_MODEL=

# Protocol used by the endpoint. "auto" probes /v1/models and picks
# openai-compatible when available, otherwise Anthropic. Override when auto
# detection guesses wrong: auto | openai | anthropic
# AI_PROTOCOL=auto

# Provider id OpenCode uses for model ids. The dashboard will show models as
# "<id>/<model>" (for example multica/general). Change it only if you need to
# match an existing setup, e.g. 9router.
# AI_PROVIDER_ID=multica

# Set to 0 on a network where the /v1/models probe cannot reach the router.
# AI_MODELS_PROBE=1

# Optional model tiers. When unset, every tier is derived from AI_MODEL, which
# always works — it just spends the main model on subagents too. Pin these for
# better cost/latency on routers with a model catalogue.
# AI_MODEL_LARGE=          # Claude Code's "opus" slot / plan mode
# AI_MODEL_MEDIUM=         # "sonnet" slot
# AI_MODEL_SMALL=          # "haiku" slot / fast background work
# AI_SUBAGENT_MODEL=       # every Task-tool subagent


# -----------------------------------------------------------------------------
# 3. Git hosting — optional
# -----------------------------------------------------------------------------
# Fine-grained GitHub token with repository access. Enables `gh` and makes
# `git push/pull` over HTTPS work with the same token.
# GH_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxx

# Commit identity. Without these, git uses whatever the task sets.
# GIT_AUTHOR_NAME=Multica Agent
# GIT_AUTHOR_EMAIL=agent@example.com


# -----------------------------------------------------------------------------
# 4. Image selection — optional
# -----------------------------------------------------------------------------
# Which published image to run with compose:
#   base | node | python | php | go | flutter | devops | qa | design
# Default: base
# MULTICA_IMAGE=ghcr.io/proreka/multica-runtime:base


# -----------------------------------------------------------------------------
# 5. PHP stack — only for the "php" image
# -----------------------------------------------------------------------------
# MariaDB, PostgreSQL and Redis start inside the container by default.
# MULTICA_START_DATABASES=1
# MULTICA_DB_NAME=laravel
# MULTICA_DB_USER=laravel
# MULTICA_DB_PASSWORD=secret
# MULTICA_MYSQL_PORT=3306
# MULTICA_POSTGRES_PORT=5432
# MULTICA_REDIS_PORT=6379
# The entrypoint does not export DB_*, so your application's .env stays in charge.
# Point it at 127.0.0.1.


# -----------------------------------------------------------------------------
# 6. UI/Design — only for the "design" image
# -----------------------------------------------------------------------------
# The agent logs into Penpot in a real browser. Credentials are read by the
# agent, not by the entrypoint. The browser profile is persisted on the
# workspaces volume.
# PENPOT_URL=https://design.penpot.app
# MULTICA_PENPOT_MCP=1
# PENPOT_MCP_SERVER_PORT=4401
# PENPOT_MCP_PLUGIN_PORT=4400


# -----------------------------------------------------------------------------
# 7. Autoscaler — only when running the autoscaler
# -----------------------------------------------------------------------------
# AUTOSCALER_PLATFORM=ecs              # ecs | swarm
# AUTOSCALER_INTERVAL=60
# AUTOSCALER_SCALEDOWN_COOLDOWN=300
# AUTOSCALER_SCALEDOWN_GRACE=120
# AUTOSCALER_DRY_RUN=0
# AUTOSCALER_ONCE=0
#
# Swarm only: GID of /var/run/docker.sock on the host.
#   stat -c '%g' /var/run/docker.sock
# DOCKER_GID=999
#
# Per-role mode (recommended). One entry per worker role:
# AUTOSCALER_RUNTIMES=[{"daemon_id":"multica-node","service":"multica-node"},{"daemon_id":"multica-php","service":"multica-php"}]
#
# ECS:
# AUTOSCALER_ECS_CLUSTER=multica
# AWS_REGION=ap-southeast-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
#
# Legacy single-pool mode (ignored when AUTOSCALER_RUNTIMES is set):
# AUTOSCALER_ECS_SERVICE=multica-worker
# AUTOSCALER_SWARM_SERVICE=multica_worker
# AUTOSCALER_TASKS_PER_WORKER=2
# AUTOSCALER_MIN_WORKERS=0
# AUTOSCALER_MAX_WORKERS=10


# -----------------------------------------------------------------------------
# 8. Diagnostics
# -----------------------------------------------------------------------------
# Resolve configuration, print the banner, and exit without contacting Multica.
# Useful for checking a bad key without hammering the API.
# MULTICA_DRY_RUN=0

{
  "family": "multica-runtime-base",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "4096",
  "memory": "8192",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "executionRoleArn": "arn:aws:iam::__ACCOUNT_ID__:role/multicaTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::__ACCOUNT_ID__:role/multicaTaskRole",
  "volumes": [
    {
      "name": "workspaces",
      "efsVolumeConfiguration": {
        "fileSystemId": "__EFS_ID__",
        "transitEncryption": "ENABLED",
        "authorizationConfig": {
          "accessPointId": "__EFS_ACCESS_POINT_ID__",
          "iam": "ENABLED"
        }
      }
    }
  ],
  "containerDefinitions": [
    {
      "name": "runtime",
      "image": "__IMAGE__",
      "essential": true,
      "user": "1000:1000",
      "stopTimeout": 90,
      "environment": [
        { "name": "MULTICA_DAEMON_ID", "value": "__DAEMON_ID__" },
        { "name": "MULTICA_AGENT_RUNTIME_NAME", "value": "__RUNTIME_NAME__" },
        { "name": "MULTICA_DAEMON_MAX_CONCURRENT_TASKS", "value": "2" },
        { "name": "AI_PROTOCOL", "value": "auto" },
        { "name": "AI_PROVIDER_ID", "value": "multica" },
        { "name": "MULTICA_WORKSPACES_ROOT", "value": "/workspaces" }
      ],
      "secrets": [
        {
          "name": "MULTICA_TOKEN",
          "valueFrom": "arn:aws:secretsmanager:__REGION__:__ACCOUNT_ID__:secret:multica/runtime:MULTICA_TOKEN::"
        },
        {
          "name": "AI_BASE_URL",
          "valueFrom": "arn:aws:secretsmanager:__REGION__:__ACCOUNT_ID__:secret:multica/runtime:AI_BASE_URL::"
        },
        {
          "name": "AI_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:__REGION__:__ACCOUNT_ID__:secret:multica/runtime:AI_API_KEY::"
        },
        {
          "name": "AI_MODEL",
          "valueFrom": "arn:aws:secretsmanager:__REGION__:__ACCOUNT_ID__:secret:multica/runtime:AI_MODEL::"
        }
      ],
      "mountPoints": [
        {
          "sourceVolume": "workspaces",
          "containerPath": "/workspaces",
          "readOnly": false
        }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "pgrep -f 'multica daemon' >/dev/null || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/multica-runtime",
          "awslogs-region": "__REGION__",
          "awslogs-stream-prefix": "runtime"
        }
      }
    }
  ]
}

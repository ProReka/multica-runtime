# =============================================================================
# Multica Runtime — tool versions (single source of truth)
# =============================================================================
# Every build consumer reads versions from THIS file and nowhere else:
#
#   scripts/build.sh              local builds
#   scripts/test-image.sh         expected binaries
#   .github/workflows/*.yml       CI builds
#
# To upgrade a tool: bump the value here, open a PR, let CI rebuild. Dockerfile
# version ARGs are declared WITHOUT defaults, so a build fails fast if a caller
# forgets to pass them.
#
# Format: KEY=VALUE, one per line. Comments must be on their own line (an inline
# comment would become part of the value). Empty values are allowed and mean
# "skip this optional component".
# =============================================================================

# --- Base image --------------------------------------------------------------
# Debian release: trixie = Debian 13 (current stable at the time of writing).
# The base Dockerfile uses debian:trixie-slim directly; this key is informational
# and is passed through so release notes can record what was built.
DEBIAN_RELEASE=trixie

# Node.js LTS (official tarball, checksum-verified).
NODE_VERSION=26.13.0

# AI coding agents (npm packages).
# Claude Code — github.com/anthropics/claude-code
CLAUDE_CODE_VERSION=2.1.314
# OpenCode V1 — github.com/anomalyco/opencode (opencode-ai)
OPENCODE_VERSION=1.19.5
# Codex CLI is deliberately NOT installed yet. See docs/roadmap.md.

# Multica CLI — github.com/multica-ai/multica
MULTICA_CLI_VERSION=0.7.2

# GitHub CLI — github.com/cli/cli
GH_CLI_VERSION=2.103.3

# --- node variant ------------------------------------------------------------
PNPM_VERSION=12.16.1
YARN_VERSION=1.22.22
TYPESCRIPT_VERSION=7.0.2
PLAYWRIGHT_VERSION=1.64.1
PLAYWRIGHT_MCP_VERSION=0.0.83
VITEST_VERSION=5.0.5
ESLINT_VERSION=10.13.0
SERVE_VERSION=14.2.6
PRETTIER_VERSION=3.9.10

# --- python variant ----------------------------------------------------------
UV_VERSION=0.13.6
POETRY_VERSION=2.5.1
RUFF_VERSION=0.17.3
MYPY_VERSION=2.4.1
PYTEST_VERSION=9.2.0

# --- php variant -------------------------------------------------------------
# PHP comes from Debian trixie (8.4). This key is informational.
PHP_VERSION=8.4

# --- go variant --------------------------------------------------------------
GO_VERSION=1.27.3
GOLANGCI_LINT_VERSION=2.15.0

# --- flutter variant ---------------------------------------------------------
FLUTTER_VERSION=3.47.9
ANDROID_CMDLINE_TOOLS_VERSION=16111833
# Space-separated sdkmanager component lists (installed verbatim).
ANDROID_PLATFORMS=platforms;android-37.2 platforms;android-36 platforms;android-35
ANDROID_BUILD_TOOLS=build-tools;37.0.0 build-tools;36.1.0 build-tools;35.0.1
# Optional NDK (~3 GB, only for native C/C++ projects). Leave empty to skip.
ANDROID_NDK_VERSION=

# --- devops variant ----------------------------------------------------------
TERRAFORM_VERSION=1.17.1
KUBECTL_VERSION=v1.37.2
HELM_VERSION=v4.3.1
AWS_CLI_VERSION=2.39.2
DOCKER_CLI_VERSION=29.9.2
DOCKER_COMPOSE_VERSION=v5.6.1
YQ_VERSION=v4.54.1
# Cloudflare Wrangler (devops variant).
WRANGLER_VERSION=4.156.0

# --- qa variant --------------------------------------------------------------
K6_VERSION=2.3.0
NEWMAN_VERSION=6.2.3
AXE_PLAYWRIGHT_VERSION=4.14.0
REQUESTS_VERSION=2.34.2
HTTPX_VERSION=0.28.1

# --- design variant ----------------------------------------------------------
# Official Penpot MCP server — github.com/penpot/penpot/tree/develop/mcp
PENPOT_MCP_VERSION=2.15.4
PILLOW_VERSION=13.0.0
FONTTOOLS_VERSION=4.68.0
CAIROSVG_VERSION=2.9.1
